# Copy this file to .env.local (gitignored) and fill in your Firebase project values.
# NEVER commit .env.local or your App Check debug token to Git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sigapwire-hybrid-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sigapwire-hybrid-ai
VITE_FIREBASE_STORAGE_BUCKET=sigapwire-hybrid-ai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check configuration:
# For production Firebase Hosting, configure reCAPTCHA v3 or Enterprise site key.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# For localhost / hackathon testing with App Check enforced:
# Set to "true" to auto-generate a debug token in browser DevTools Console,
# or paste your registered debug token UUID here in .env.local only.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true
